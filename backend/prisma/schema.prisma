// Database schema for Teach Tren. Run `npm run db:migrate` after changing it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MaterialType {
  PDF
  DOCX
  PPTX
}

enum MaterialStatus {
  MENGUNGGAH
  MEMPROSES
  SIAP
  GAGAL
}

// A study material (materi). The file itself is not stored: only its checked metadata and the summary.
model Material {
  id              String         @id @default(uuid())
  userId          String
  title           String
  type            MaterialType
  sizeBytes       Int
  status          MaterialStatus
  summary         String[]       @default([])
  suggestedTopics String[]       @default([])
  // Text read from the file (docs/role.md, Materi). Kept up to MAX_STORED_CHARS.
  teksEkstrak     String?
  error           String?
  // Id of the topic (bulat) this material is linked to. Null when not linked.
  topicId         String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, topicId])
}

enum ScheduleKind {
  LATIHAN
  ULANG
  BARU
  SARAN
  ISTIRAHAT
  // Topic already mastered (hijau di kalender, CC-08).
  DIKUASAI
}

// One item of the study calendar. A suggestion (SARAN) becomes a normal item once it is accepted or moved.
model ScheduleItem {
  id        String       @id @default(uuid())
  userId    String
  // Calendar date, YYYY-MM-DD.
  date      String
  title     String
  kind      ScheduleKind
  reason    String       @default("")
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// Marks that the daily suggestion job ran for a user on a day. The memory hash lets the job skip the AI
// when nothing changed since the last run.
model ScheduleRun {
  userId     String
  runDate    String
  memoryHash String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, runDate])
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  // Set when the account is deleted. The account can be restored by signing in again within 30 days.
  deletionScheduledAt DateTime?
  createdAt    DateTime       @default(now())
  topics       Topic[]
  links        TopicLink[]
  conversations Conversation[]
  attempts     QuizAttempt[]
  materials    Material[]
  scheduleItems ScheduleItem[]
  scheduleRuns ScheduleRun[]
  bankSeen     BankSeen[]
  preferences  UserPreference?
  learningPlan LearningPlan?
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  generatedMaterials GeneratedMaterial[]
}

// A topic (bulat). The id is unique per user, so the same slug can exist for two accounts.
model Topic {
  userId            String
  id                String
  name              String
  // Subject used for quiz prompts and checks, for example Matematika or IPA.
  subject           String        @default("Umum")
  x                 Float         @default(0)
  y                 Float         @default(0)
  unlocked          Boolean       @default(true)
  pendingSuggestion Boolean       @default(false)
  lastScore         Int?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts          QuizAttempt[]

  @@id([userId, id])
}

// A link between two topics of the same user. Suggested links are shown dashed on the canvas.
model TopicLink {
  id        String  @id @default(uuid())
  userId    String
  sourceId  String
  targetId  String
  suggested Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, targetId])
}

model Conversation {
  userId    String
  id        String
  title     String
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@id([userId, id])
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  streaming
  done
  stopped
}

model Message {
  // Message ids only need to be unique inside their conversation.
  id             String
  userId         String
  conversationId String
  role           MessageRole
  content        String
  status         MessageStatus
  position       Int
  createdAt DateTime @default(now())
  conversation   Conversation  @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade)

  @@id([userId, conversationId, id])
  @@index([userId, conversationId, position])
}

// A sign-in with Google, Facebook, or TikTok linked to an account. One provider user is linked to one account.
model OAuthAccount {
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerUserId])
  @@index([userId])
}

// Refresh token of a session. Only a hash is stored. A token is used once: each refresh replaces it.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Study preferences of a signed-in user (docs/role.md 4.7). Defaults match the browser's first version.
model UserPreference {
  userId                   String  @id
  questionCount            Int     @default(10)
  level                    String  @default("Sedang")
  quizStyle                String  @default("Campuran")
  quickChoiceAfterMaterial Boolean @default(true)
  theme                    String  @default("light")
  reminderEnabled          Boolean @default(true)
  reminderTime             String  @default("16:00")
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The learning plan of a signed-in user, chosen before the first visit to Learning: level, grade, and subjects.
// The materials the user picked became topics of the roadmap. One plan per account.
model LearningPlan {
  userId    String   @id
  levelId   String
  grade     Int
  subjects  String[] @default([])
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Study material written by the AI for one topic. It is made one part at a time, so each part has a position.
model GeneratedMaterial {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  position  Int
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, position])
}

// AI actions used on this device by a guest. Guests get two actions in total (docs/role.md 2.3).
model GuestUsage {
  guestId   String   @id
  actions   Int      @default(0)
  // Bulat made with AI on this device. A guest may do it once, then signing in is needed.
  generated Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One finished quiz run. The topic's lastScore is the most recent percent.
model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  percent   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [userId, topicId], references: [userId, id], onDelete: Cascade)

  @@index([userId, topicId])
}

enum QuestionType {
  PG
  CERITA
  ISIAN
  ESAI
}

// Long text shared by several questions of the same topic and level. Stored once and reused.
model Stimulus {
  id        String   @id @default(uuid())
  topicKey  String
  level     String
  text      String
  createdAt DateTime @default(now())

  questions BankQuestion[]

  @@index([topicKey, level])
}

// Question bank (docs/role.md section 9): questions are generated once per topic, level, and type, then reused.
model BankQuestion {
  id              String       @id @default(uuid())
  topicKey        String
  level           String
  subject         String
  type            QuestionType
  stimulusId      String?
  stimulus        Stimulus?    @relation(fields: [stimulusId], references: [id], onDelete: SetNull)
  prompt          String
  options         Json?
  answer          String?
  acceptedAnswers String[]     @default([])
  rubric          Json?
  explanation     String
  createdAt       DateTime     @default(now())
  seen            BankSeen[]

  @@index([topicKey, level, type])
}

// Questions a signed-in user has already done. Reuse from the bank skips them.
model BankSeen {
  userId     String
  bankId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank       BankQuestion @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@id([userId, bankId])
}

// One quiz run. Answer keys stay on the server. Retry runs contain only the questions answered wrong.
model QuizRun {
  id        String   @id @default(uuid())
  userId    String?
  guestId   String?
  topicId   String?
  topicName String
  subject   String
  level     String
  style     String
  count     Int
  retry     Boolean  @default(false)
  status    String   @default("BERJALAN")
  percent   Int?
  stimuli   Json
  createdAt DateTime @default(now())
  finishedAt DateTime?
  items     QuizItem[]

  @@index([userId, createdAt])
  @@index([guestId])
}

model QuizItem {
  id              String       @id @default(uuid())
  quizId          String
  quiz            QuizRun      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position        Int
  type            QuestionType
  stimulusId      String?
  prompt          String
  options         Json?
  answer          String?
  acceptedAnswers String[]     @default([])
  rubric          Json?
  explanation     String
  bankId          String?
  userAnswer      String?
  score           Int?
  feedback        String?
  lowConfidence   Boolean      @default(false)

  @@index([quizId, position])
}
