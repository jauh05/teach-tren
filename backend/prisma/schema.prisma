// Database schema for Teach Tren. Run `npm run db:migrate` after changing it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MaterialType {
  PDF
  DOCX
  PPTX
}

enum MaterialStatus {
  MENGUNGGAH
  MEMPROSES
  SIAP
  GAGAL
}

// A study material (materi). The file itself is not stored: only its checked metadata and the summary.
model Material {
  id              String         @id @default(uuid())
  userId          String
  title           String
  type            MaterialType
  sizeBytes       Int
  status          MaterialStatus
  summary         String[]       @default([])
  suggestedTopics String[]       @default([])
  error           String?
  // Id of the topic (bulat) this material is linked to. Null when not linked.
  topicId         String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, topicId])
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  // Set when the account is deleted. The account can be restored by signing in again within 30 days.
  deletionScheduledAt DateTime?
  createdAt    DateTime       @default(now())
  topics       Topic[]
  links        TopicLink[]
  conversations Conversation[]
  attempts     QuizAttempt[]
  materials    Material[]
}

// A topic (bulat). The id is unique per user, so the same slug can exist for two accounts.
model Topic {
  userId            String
  id                String
  name              String
  x                 Float         @default(0)
  y                 Float         @default(0)
  unlocked          Boolean       @default(true)
  pendingSuggestion Boolean       @default(false)
  lastScore         Int?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts          QuizAttempt[]

  @@id([userId, id])
}

// A link between two topics of the same user. Suggested links are shown dashed on the canvas.
model TopicLink {
  id        String  @id @default(uuid())
  userId    String
  sourceId  String
  targetId  String
  suggested Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, targetId])
}

model Conversation {
  userId    String
  id        String
  title     String
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@id([userId, id])
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  streaming
  done
  stopped
}

model Message {
  // Message ids only need to be unique inside their conversation.
  id             String
  userId         String
  conversationId String
  role           MessageRole
  content        String
  status         MessageStatus
  position       Int
  createdAt DateTime @default(now())
  conversation   Conversation  @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade)

  @@id([userId, conversationId, id])
  @@index([userId, conversationId, position])
}

// AI actions used on this device by a guest. Guests get two actions in total (docs/role.md 2.3).
model GuestUsage {
  guestId   String   @id
  actions   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One finished quiz run. The topic's lastScore is the most recent percent.
model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  percent   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [userId, topicId], references: [userId, id], onDelete: Cascade)

  @@index([userId, topicId])
}
