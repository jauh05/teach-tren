// Database schema for Teach Tren. Run `npm run db:migrate` after changing it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  topics       Topic[]
  links        TopicLink[]
  conversations Conversation[]
  attempts     QuizAttempt[]
}

// A topic (bulat). The id is unique per user, so the same slug can exist for two accounts.
model Topic {
  userId            String
  id                String
  name              String
  x                 Float         @default(0)
  y                 Float         @default(0)
  unlocked          Boolean       @default(true)
  pendingSuggestion Boolean       @default(false)
  lastScore         Int?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts          QuizAttempt[]

  @@id([userId, id])
}

// A link between two topics of the same user. Suggested links are shown dashed on the canvas.
model TopicLink {
  id        String  @id @default(uuid())
  userId    String
  sourceId  String
  targetId  String
  suggested Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, targetId])
}

model Conversation {
  userId    String
  id        String
  title     String
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@id([userId, id])
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  streaming
  done
  stopped
}

model Message {
  id             String        @id
  userId         String
  conversationId String
  role           MessageRole
  content        String
  status         MessageStatus
  position       Int
  conversation   Conversation  @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade)

  @@index([userId, conversationId, position])
}

// One finished quiz run. The topic's lastScore is the most recent percent.
model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  percent   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [userId, topicId], references: [userId, id], onDelete: Cascade)

  @@index([userId, topicId])
}
