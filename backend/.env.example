# Salin ke backend/.env untuk pengembangan lokal. Jangan commit nilai asli.

# Database dari `npm run db:start` memakai nilai di bawah ini. Ganti jika kamu memakai PostgreSQL sendiri.
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/teach_tren
# Database khusus test. Nama harus berakhiran _test, karena test menghapus semua data di dalamnya.
TEST_DATABASE_URL=postgresql://postgres:devpass@localhost:5432/teach_tren_test

# Minimal 32 karakter dan harus acak. Dipakai untuk menandatangani sesi masuk.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-rahasia-minimal-32-karakter
PORT=3001
# Alamat frontend yang boleh memanggil API dengan cookie.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Batas percobaan masuk dan daftar. Percobaan masuk dihitung per email dari satu alamat IP, dan per alamat IP.
AUTH_ATTEMPTS_PER_15_MIN=10
AUTH_IP_PER_15_MIN=100
REGISTER_PER_HOUR=30
# Saran pola dari AI per akun per jam.
POLA_SARAN_PER_HOUR=20
# Bagian materi dari AI per akun per jam.
MATERI_BULAT_PER_HOUR=30
# Jumlah proxy di depan server. Isi 1 jika memakai satu reverse proxy (misalnya Nginx), supaya alamat IP pengguna terbaca benar.
TRUST_PROXY=0

# Kunci OpenRouter. Wajib saat AI_MODE=live. Jangan di-commit dan jangan ditaruh di frontend.
OPENROUTER_API_KEY=ganti-dengan-kunci-openrouter

# Mode AI. "mock" tidak memanggil model (dipakai test dan e2e). "live" memanggil OpenRouter.
AI_MODE=mock
# Rantai model per kelompok tugas, urutan prioritas, dipisahkan koma. Slug diambil dari katalog OpenRouter.
# Model: openai/gpt-oss-20b (berbayar). Dipilih setelah uji: model gratis kena 429 dan jawaban chat-nya lebih pendek.
AI_CHAIN_CHAT=openai/gpt-oss-20b
AI_CHAIN_KUIS=openai/gpt-oss-20b
AI_CHAIN_RINGAN=openai/gpt-oss-20b
AI_TIMEOUT_MS=45000
AI_TIMEOUT_KUIS_MS=120000
AI_MAX_TOKENS_CHAT=1200
# Batas token kuis. docs/role.md menulis 3000, tetapi 3000 memotong sekitar seperempat panggilan kuis.
# 7000 dipilih dari pengukuran di docs/model-eval.md. Perkiraan biaya sekitar Rp20 per kuis 10 soal.
AI_MAX_TOKENS_KUIS=7000
AI_EFFORT_CHAT=low
AI_EFFORT_KUIS=medium
AI_EFFORT_RINGAN=low

# Masuk dengan Google, Facebook, dan TikTok. Kosongkan jika belum ada. Tombolnya tetap ada, tetapi menampilkan pesan belum tersedia.
# Alamat yang dipakai browser untuk membuka aplikasi. Di pengembangan: http://localhost:5173.
OAUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

