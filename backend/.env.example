# Salin ke backend/.env untuk pengembangan lokal. Jangan commit nilai asli.
DATABASE_URL=postgresql://postgres:ganti-password@localhost:5432/teach_tren
# Minimal 32 karakter. Dipakai untuk menandatangani sesi masuk.
JWT_SECRET=ganti-dengan-rahasia-minimal-32-karakter
PORT=3001
# Alamat frontend yang boleh memanggil API dengan cookie.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Database khusus test. Nama harus berakhiran _test, karena test menghapus semua data di dalamnya.
TEST_DATABASE_URL=postgresql://postgres:ganti-password@localhost:5432/teach_tren_test
# Kunci OpenRouter. Wajib saat AI_MODE=live. Jangan di-commit dan jangan ditaruh di frontend.
OPENROUTER_API_KEY=ganti-dengan-kunci-openrouter

# Mode AI. "mock" tidak memanggil model (dipakai test dan e2e). "live" memanggil OpenRouter.
AI_MODE=mock
# Rantai model per kelompok tugas, urutan prioritas, dipisahkan koma. Slug diambil dari katalog OpenRouter.
# chat: paling murah dan cepat. Model kedua dan ketiga cadangan. Claude Haiku 5.5 dipakai bila yang lain gagal.
AI_CHAIN_CHAT=inclusionai/ling-3.1-flash,openai/gpt-oss-20b,google/gemini-2.5-flash-lite,anthropic/claude-haiku-5.5
# kuis: soal dan penilaian butuh ketelitian. Claude Haiku 5.5 di depan karena paling akurat untuk JSON dan rumus.
AI_CHAIN_KUIS=anthropic/claude-haiku-5.5,qwen/qwen3.7-flash,google/gemini-2.5-flash-lite,nvidia/nemotron-3-ultra-550b-a55b:free
# ringan: saran jadwal, klasifikasi, dan perbaikan JSON. Model kecil sudah cukup.
AI_CHAIN_RINGAN=openai/gpt-oss-20b,inclusionai/ling-3.1-flash,google/gemma-3-12b-it,anthropic/claude-haiku-5.5
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS_CHAT=1200
AI_MAX_TOKENS_KUIS=3000
